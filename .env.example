# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API Keys.
# Both values are safe to be public: the publishable key only allows what the database's
# row-level security rules allow. Never put the SECRET key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server only (never NEXT_PUBLIC_): reads recipe photos and estimates nutrition with Google
# Gemini's free tier. Without it the app works; the AI buttons say AI isn't set up.
GEMINI_API_KEY=

# Server only: the shared demo account's password (docs/decisions/0026). At least 16
# characters; leave empty to hide the "Try the demo" button.
DEMO_PASSWORD=
