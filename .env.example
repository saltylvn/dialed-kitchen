# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API Keys.
# Both values are safe to be public: the publishable key only allows what the database's
# row-level security rules allow. Never put the SECRET key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
