# Copy to .env.local (git-ignored) and fill in. Every value is read on the server only;
# none of them is sent to the browser (docs/decisions/0049).

# Neon Auth (sign-in) and Neon's Data API (queries) for your branch. Print them with
# `neon neon-auth status` and `neon data-api get`.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_DATA_API_URL=https://ep-xxxx.apirest.us-east-1.aws.neon.tech/neondb/rest/v1

# Secret: signs this app's short-lived session cookie. Make one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Secret: the sign-up gate's own database login, used only by the Neon Auth webhook.
# Written for you by: npm run db:gate-password
SIGNUP_GATE_DATABASE_URL=

# Server only: reads recipe photos and estimates nutrition with Google Gemini's free tier.
# Without it the app works; the AI buttons say AI isn't set up.
GEMINI_API_KEY=

# Server only: the shared demo account's password (docs/decisions/0026). At least 16
# characters; leave empty to hide the "Try the demo" button.
DEMO_PASSWORD=
